{
  "name": "@read-frog/extension",
  "version": "1.47.4",
  "private": true,
  "description": "Read Frog browser extension for language learning",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
